# GitHub Actions workflow for typikon-consuming sites.
#
# This file is a TEMPLATE. typikon-init copies it to a consumer site as
# .github/workflows/deploy.yml during scaffolding, substituting the two
# placeholders below.
#
# Placeholders (typikon-init replaces during scaffolding):
#   {{ PROJECT_NAME }}   — Cloudflare Pages project slug (e.g. ardent-site)
#   {{ ZOLA_VERSION }}   — pinned Zola version (current: 0.22.1)
#
# After substitution the workflow performs the strict gate, then deploys
# to Cloudflare Pages on green pushes to main.
#
# Secrets the consumer must set in GitHub repo settings:
#   - CLOUDFLARE_API_TOKEN
#   - CLOUDFLARE_ACCOUNT_ID

name: Deploy to Cloudflare Pages

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]

jobs:
  gate-and-deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          submodules: recursive  # Pulls typikon as themes/typikon/

      # ── Tooling install ────────────────────────────────────────
      - name: Install Zola
        run: |
          curl -L "https://github.com/getzola/zola/releases/download/v{{ ZOLA_VERSION }}/zola-v{{ ZOLA_VERSION }}-x86_64-unknown-linux-gnu.tar.gz" \
            -o zola.tar.gz
          tar -xzf zola.tar.gz
          sudo mv zola /usr/local/bin/
          zola --version

      - name: Install Python deps for typikon-validate
        run: |
          python3 -m pip install --user jsonschema

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install pa11y-ci, lychee, playwright
        run: |
          npm install -g pa11y-ci@latest @playwright/test@latest
          npx playwright install --with-deps chromium
          curl -L https://github.com/lycheeverse/lychee/releases/latest/download/lychee-x86_64-unknown-linux-gnu.tar.gz \
            -o lychee.tar.gz
          mkdir -p lychee-extract
          tar -xzf lychee.tar.gz -C lychee-extract --strip-components=1
          sudo mv lychee-extract/lychee /usr/local/bin/
          rm -rf lychee.tar.gz lychee-extract

      # ── Strict gate ────────────────────────────────────────────
      - name: typikon-validate (frontmatter schemas)
        run: themes/typikon/bin/typikon-validate .

      - name: zola check (internal links + assets)
        run: zola check

      - name: zola build
        run: zola build

      - name: csp-enforce (no inline script/style/handlers)
        run: themes/typikon/ci/csp-enforce.sh public/

      - name: lychee (external links)
        run: lychee --config themes/typikon/ci/lychee.toml --root-dir "$GITHUB_WORKSPACE/public" public/

      - name: Serve public/ for browser-based gates
        run: |
          cd public && python3 -m http.server 8080 &
          echo $! > /tmp/server.pid
          sleep 2

      - name: pa11y (WCAG 2.1 AA)
        run: pa11y-ci --config themes/typikon/ci/pa11y.config.js

      - name: playwright (per-route smoke)
        if: ${{ hashFiles('tests/smoke/**/*.spec.ts') != '' }}
        run: |
          cp themes/typikon/ci/playwright.config.ts ./playwright.config.ts
          npx playwright test

      - name: Tear down static server
        if: always()
        run: |
          kill "$(cat /tmp/server.pid 2>/dev/null)" 2>/dev/null || true

      # ── Deploy on green pushes to main only ───────────────────
      - name: Deploy to Cloudflare Pages
        if: github.event_name == 'push' && github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
        run: |
          npm install -g wrangler
          wrangler pages deploy public --project-name={{ PROJECT_NAME }}
