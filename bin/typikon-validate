#!/usr/bin/env python3
"""typikon-validate — frontmatter validator for typikon-consuming sites.

Usage:
    typikon-validate <consumer-site-root>

Walks <root>/content/**/*.md, parses TOML frontmatter (between +++ lines),
classifies each file by its location, and validates against the appropriate
JSON Schema in <typikon-repo>/schemas/.

Classification rules:
    content/_index.md                       -> section.schema.json
    content/<section>/_index.md             -> section.schema.json
    content/journal/<slug>.md               -> journal-entry.schema.json
    content/products/<slug>.md              -> product.schema.json
    content/<everything-else>.md            -> page.schema.json

Output:
    JSONL on stderr, one line per failure:
        {"file": "...", "pointer": "/extra/price", "error": "..."}
    Summary on stdout (exit-zero only when zero failures):
        {"checked": 17, "passed": 17, "failed": 0}

Exit codes:
    0 — all files valid
    1 — at least one file invalid
    2 — runtime error (missing schemas, malformed frontmatter, etc.)
"""

from __future__ import annotations

import datetime as _datetime
import json
import sys
import tomllib
from pathlib import Path

try:
    from jsonschema import Draft202012Validator
except ImportError:
    print(
        json.dumps({"error": "jsonschema package required (pip install jsonschema)"}),
        file=sys.stderr,
    )
    sys.exit(2)


THEME_ROOT = Path(__file__).resolve().parent.parent
SCHEMA_DIR = THEME_ROOT / "schemas"


def classify(rel_path: Path) -> str:
    """Map a markdown file's path under content/ to its schema name."""
    parts = rel_path.parts
    # parts[0] == "content"
    name = parts[-1]
    if name == "_index.md":
        return "section"
    # content/<x>.md is a top-level page
    if len(parts) == 2:
        return "page"
    # content/<section>/<file>.md
    section = parts[1]
    if section == "journal":
        return "journal-entry"
    if section == "products":
        return "product"
    return "page"


def _coerce_dates(obj):
    """Recursively turn datetime.date / datetime.datetime into ISO 8601 strings.

    TOML date literals (`date = 2026-01-20`) parse to Python date objects.
    JSON Schema's `format: date` validates strings, not date objects, so we
    coerce before validation. This matches Zola's wire-format expectation
    (dates serialize to ISO strings in templates).
    """
    if isinstance(obj, _datetime.datetime):
        return obj.isoformat()
    if isinstance(obj, _datetime.date):
        return obj.isoformat()
    if isinstance(obj, dict):
        return {k: _coerce_dates(v) for k, v in obj.items()}
    if isinstance(obj, list):
        return [_coerce_dates(v) for v in obj]
    return obj


def parse_frontmatter(text: str, file_label: str) -> dict:
    """Extract TOML frontmatter from a Zola markdown file."""
    if not text.startswith("+++"):
        raise ValueError(f"{file_label}: missing TOML frontmatter (must start with +++)")
    end = text.find("\n+++", 4)
    if end == -1:
        raise ValueError(f"{file_label}: unterminated TOML frontmatter")
    block = text[4:end].strip()
    return _coerce_dates(tomllib.loads(block))


def validate_file(path: Path, content_root: Path, schemas: dict[str, dict]) -> list[dict]:
    """Return a list of failure records for one file (empty when all good)."""
    rel = path.relative_to(content_root.parent)  # keep "content/..." prefix
    file_label = str(rel)

    try:
        text = path.read_text(encoding="utf-8")
    except Exception as exc:
        return [{"file": file_label, "pointer": "", "error": f"read failed: {exc}"}]

    try:
        fm = parse_frontmatter(text, file_label)
    except Exception as exc:
        return [{"file": file_label, "pointer": "", "error": str(exc)}]

    schema_name = classify(rel)
    schema = schemas.get(schema_name)
    if schema is None:
        return [{"file": file_label, "pointer": "", "error": f"no schema for class '{schema_name}'"}]

    validator = Draft202012Validator(schema)
    failures = []
    for err in sorted(validator.iter_errors(fm), key=lambda e: e.path):
        pointer = "/" + "/".join(str(p) for p in err.absolute_path)
        failures.append({
            "file": file_label,
            "schema": schema_name,
            "pointer": pointer,
            "error": err.message,
        })
    return failures


def load_schemas() -> dict[str, dict]:
    schemas: dict[str, dict] = {}
    for slug in ("page", "section", "journal-entry", "product"):
        p = SCHEMA_DIR / f"{slug}.schema.json"
        if not p.exists():
            print(json.dumps({"error": f"missing schema: {p}"}), file=sys.stderr)
            sys.exit(2)
        schemas[slug] = json.loads(p.read_text(encoding="utf-8"))
    return schemas


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("usage: typikon-validate <consumer-site-root>", file=sys.stderr)
        return 2

    root = Path(argv[1]).resolve()
    content_root = root / "content"
    if not content_root.is_dir():
        print(json.dumps({"error": f"no content/ dir under {root}"}), file=sys.stderr)
        return 2

    schemas = load_schemas()
    files = sorted(content_root.rglob("*.md"))
    failures: list[dict] = []
    for f in files:
        failures.extend(validate_file(f, content_root, schemas))

    for failure in failures:
        print(json.dumps(failure), file=sys.stderr)

    summary = {"checked": len(files), "passed": len(files) - len({f["file"] for f in failures}), "failed": len({f["file"] for f in failures})}
    print(json.dumps(summary))
    return 0 if not failures else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
