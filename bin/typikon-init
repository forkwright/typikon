#!/usr/bin/env bash
# typikon-init — scaffold a new typikon-consuming site.
#
# Usage:
#     typikon-init <site-name> <destination-path>
#
# Creates a fleet web-property repo that consumes typikon. Idempotent:
# re-running over an existing destination refreshes scaffolded files
# without overwriting consumer-edited content.
#
# What it writes:
#     <dest>/
#     ├── .git/                     (git init, remotes set: origin=forge, github=mirror)
#     ├── .gitignore                (zola public/, editor crud)
#     ├── .kanon-ci.toml            (strict forge-primary deploy gate)
#     ├── themes/typikon/           (git submodule -> forkwright/typikon)
#     ├── config.toml               (Zola config with placeholder [extra])
#     ├── content/_index.md         (homepage stub)
#     ├── content/about.md          (placeholder)
#     ├── content/contact.md        (placeholder)
#     ├── static/img/.gitkeep       (consumer images go here)
#     ├── _headers                  (instance of typikon's _headers.tmpl)
#     ├── _redirects                (instance of typikon's _redirects.tmpl)
#     ├── tests/smoke/.gitkeep      (per-route Playwright assertions)
#     └── CLAUDE.md                 (operator brief, consumer-specific)
#
# After scaffolding, the user runs:
#     cd <dest>
#     bin/typikon-check .          (validates + builds; should green)
#     git push origin main         (will need ALLOW_PROTECTED_PUSH=1 for
#                                   the first push; see <internal-issue-id>)

set -euo pipefail

THEME_REPO="${TYPIKON_THEME_REPO:-http://127.0.0.1:7878/forkwright/typikon.git}"
THEME_REPO_GH="${TYPIKON_THEME_REPO_GH:-git@github.com:forkwright/typikon.git}"
TYPIKON_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
    cat <<EOF >&2
typikon-init — scaffold a typikon-consuming site

Usage:
    typikon-init <site-name> <destination-path>

Arguments:
    site-name           lowercase ASCII name; becomes the forge/GitHub repo slug
    destination-path    where to scaffold; created if absent

Environment:
    TYPIKON_THEME_REPO     forge URL the theme submodule checkout is
                           redirected to locally (default: $THEME_REPO)
    TYPIKON_THEME_REPO_GH  GitHub URL recorded in .gitmodules, so the
                           submodule stays reachable off-box (CI, a
                           fresh clone) (default: $THEME_REPO_GH)
EOF
    exit 2
}

[[ $# -ne 2 ]] && usage

SITE_NAME="$1"
DEST="$(realpath -m "$2")"

if [[ ! "$SITE_NAME" =~ ^[a-z][a-z0-9-]*$ ]]; then
    echo "error: site-name must be lowercase ASCII letters/digits/hyphens, starting with a letter" >&2
    exit 2
fi

mkdir -p "$DEST"
cd "$DEST"

if [[ ! -d .git ]]; then
    git init -q -b main
    git remote add origin "http://127.0.0.1:7878/forkwright/${SITE_NAME}.git"
    git remote add github "git@github.com:forkwright/${SITE_NAME}.git"
fi

# Theme submodule (or refresh if already present). .gitmodules records
# the GitHub URL so a network-isolated clone (CI runners, off-fleet
# checkouts) can init the submodule with no local state; the checked-
# out submodule's own `origin` is then redirected to the forge so the
# operator's day-to-day pulls (and typikon-refresh's `git pull` inside
# themes/typikon) hit the forge, not GitHub.
if [[ ! -d themes/typikon/.git && ! -f themes/typikon/theme.toml ]]; then
    mkdir -p themes
    git submodule add "$THEME_REPO_GH" themes/typikon
    git config submodule.themes/typikon.url "$THEME_REPO"
    git -C themes/typikon remote set-url origin "$THEME_REPO"
else
    # WARNING: must not be `set -e`-fatal — an offline/unreachable forge on
    # a re-run must not abort the whole scaffold over an already-checked-out
    # submodule — but the prior `2>/dev/null || true` converted EVERY
    # failure into silent success with no trace anywhere (forkwright/typikon#92).
    if ! PULL_OUTPUT="$(cd themes/typikon && git pull --ff-only origin main 2>&1)"; then
        echo "warn   themes/typikon: refresh failed, continuing with existing checkout: ${PULL_OUTPUT//$'\n'/ }" >&2
    fi
fi

# INVARIANT: OWN_OUTPUTS accumulates only the paths THIS invocation
# itself created — never a blanket sweep. It is the sole input to the
# staging step below, so a path never written by this run cannot end
# up staged by it (forkwright/typikon#54).
declare -a OWN_OUTPUTS=()

# WHY: an absent path is ambiguous between "never scaffolded" (create it)
# and "scaffolded, committed, then the operator deliberately removed it"
# (leave it removed — forkwright/typikon#54's "preserve pre-existing
# worktree state" covers deletions, not only unrelated files elsewhere in
# the repo). `git cat-file -e HEAD:<path>` distinguishes them: it succeeds
# only when the path was present in the last scaffold commit. No HEAD yet
# (the very first invocation) means nothing has ever been committed, so
# every path is unambiguously the first case.
tracked_in_head() {
    local path="$1"
    git rev-parse --verify -q HEAD >/dev/null 2>&1 || return 1
    git cat-file -e "HEAD:$path" 2>/dev/null
}

# Idempotent file writes — only create if absent AND never previously
# scaffolded-then-deleted. Consumer-edited content stays either way.
write_if_absent() {
    local path="$1"
    local content="$2"
    if [[ -e "$path" ]]; then
        echo "skip   $path (exists)" >&2
    elif tracked_in_head "$path"; then
        echo "skip   $path (removed since the last scaffold commit; not recreated)" >&2
    else
        mkdir -p "$(dirname "$path")"
        printf '%s' "$content" > "$path"
        echo "create $path" >&2
        OWN_OUTPUTS+=("$path")
    fi
}

# Copy templates from typikon (create-if-absent — same model as
# write_if_absent above, not a refresh). _headers/_redirects are
# scaffolded here ONCE; typikon-refresh deliberately does not re-render
# them on a later bump (see its own header), so they are the operator's
# to hand-edit from this point on. That is the opposite of
# .kanon-ci.toml / the GitHub workflow, which typikon-refresh DOES treat
# as fully derived and re-renders every bump.
copy_template() {
    local src="$1"
    local dest="$2"
    if [[ -e "$dest" ]]; then
        echo "skip   $dest (exists; remove to refresh)" >&2
    elif tracked_in_head "$dest"; then
        echo "skip   $dest (removed since the last scaffold commit; not recreated)" >&2
    else
        cp "$src" "$dest"
        echo "create $dest (from $src)" >&2
        OWN_OUTPUTS+=("$dest")
    fi
}

copy_template "$TYPIKON_ROOT/_headers.tmpl" "_headers"
copy_template "$TYPIKON_ROOT/_redirects.tmpl" "_redirects"

# CI workflow templates - substitute placeholders during copy.
# ZOLA_VERSION default lives in bin/typikon-defaults.sh (single source
# of truth shared with typikon-refresh); env-var override stays the
# same shape (`TYPIKON_ZOLA_VERSION=... typikon-init ...`).
# shellcheck source=./typikon-defaults.sh
ZOLA_VERSION="${TYPIKON_ZOLA_VERSION:-}"
WRANGLER_VERSION="${TYPIKON_WRANGLER_VERSION:-}"
. "$TYPIKON_ROOT/bin/typikon-defaults.sh"
mkdir -p .github/workflows
if [[ -e .github/workflows/deploy.yml ]]; then
    echo "skip   .github/workflows/deploy.yml (exists)" >&2
elif tracked_in_head ".github/workflows/deploy.yml"; then
    echo "skip   .github/workflows/deploy.yml (removed since the last scaffold commit; not recreated)" >&2
else
    sed -e "s|{{ PROJECT_NAME }}|${SITE_NAME}|g" \
        -e "s|{{ ZOLA_VERSION }}|${ZOLA_VERSION}|g" \
        -e "s|{{ WRANGLER_VERSION }}|${WRANGLER_VERSION}|g" \
        "$TYPIKON_ROOT/ci/github-workflow.yml.tmpl" \
        > .github/workflows/deploy.yml
    echo "create .github/workflows/deploy.yml (from ci/github-workflow.yml.tmpl)" >&2
    OWN_OUTPUTS+=(".github/workflows/deploy.yml")
fi

if [[ -e .kanon-ci.toml ]]; then
    echo "skip   .kanon-ci.toml (exists)" >&2
elif tracked_in_head ".kanon-ci.toml"; then
    echo "skip   .kanon-ci.toml (removed since the last scaffold commit; not recreated)" >&2
else
    sed -e "s|{{ PROJECT_NAME }}|${SITE_NAME}|g" \
        -e "s|{{ ZOLA_VERSION }}|${ZOLA_VERSION}|g" \
        -e "s|{{ WRANGLER_VERSION }}|${WRANGLER_VERSION}|g" \
        "$TYPIKON_ROOT/ci/kanon-ci.toml.tmpl" \
        > .kanon-ci.toml
    echo "create .kanon-ci.toml (from ci/kanon-ci.toml.tmpl)" >&2
    OWN_OUTPUTS+=(".kanon-ci.toml")
fi

write_if_absent ".gitignore" "$(cat <<'GITIGNORE'
public/
.zola-cache/
.DS_Store
*.swp
node_modules/
.lychee_cache/
test-results/
playwright-report/
.playwright/
*.local
.env
.env.local
GITIGNORE
)
"

write_if_absent "config.toml" "$(cat <<EOF
# Zola config for ${SITE_NAME}. Consumer-specific values live under [extra].
title = "${SITE_NAME}"
description = "TODO: site description"
base_url = "https://${SITE_NAME}.example.com"
default_language = "en"
output_dir = "public"
theme = "typikon"
generate_feeds = true
feed_filenames = ["atom.xml"]

[markdown]
smart_punctuation = true

[extra]
# Brand identity — read by typikon's base.html / nav.html / footer.html.
brand_name = "${SITE_NAME}"
# brand_greek = "Greek motto for footer + nav-logo hover"
# logo_path = "img/logo.svg"
# favicon_path = "img/favicon.svg"
# theme_color = "#F7F3E8"
# og_locale = "en_US"
# og_image = "img/og-cover.png"

# Self-hosted font preload list (relative URLs under /fonts/). Cormorant
# Garamond is a variable WOFF2 (covers all weights via the wght axis);
# Spectral is a static cut at 400 (Production Type ships no variable yet).
font_preload = ["/fonts/cormorant-garamond-variable.woff2", "/fonts/spectral-400.woff2"]

# Top-nav structure. Each item: { url, label, greek? }.
nav_items = []

# Footer link list. Each item: { url, label, rel? }.
footer_links = []

# Declared exceptions for the asset-provenance gate stage (glob paths,
# matched against each asset's URL under /). Leave unset to fail the gate
# on any embedded C2PA manifest; declare a path here only for an asset
# whose Content Credentials this site deliberately keeps.
# c2pa_declared_assets = ["/img/photography/*.jpg"]
EOF
)
"

write_if_absent "content/_index.md" "$(cat <<EOF
+++
title = "${SITE_NAME}"
description = "TODO: site description"

[extra]
# body_class = "home-page"
# template = "index.html"
+++

TODO: home content.
EOF
)
"

write_if_absent "content/about.md" "$(cat <<'EOF'
+++
title = "About"
description = "TODO: meta description (120-180 chars)."
+++

TODO: about content.
EOF
)
"

write_if_absent "content/contact.md" "$(cat <<'EOF'
+++
title = "Contact"
description = "TODO: meta description (120-180 chars)."
+++

TODO: contact content.
EOF
)
"

# Routed through write_if_absent (empty content) rather than a bare
# `mkdir -p && touch`: a `.gitkeep` an operator deleted on purpose — the
# normal move once a directory holds real content — must stay deleted,
# the same guard content/contact.md etc. get above.
write_if_absent "static/img/.gitkeep" ""
write_if_absent "tests/smoke/.gitkeep" ""

# CLAUDE.md (operator brief). Force-add at commit time per
# global-gitignore rules (~/.config/git/ignore excludes CLAUDE.md by default).
write_if_absent "CLAUDE.md" "$(cat <<EOF
# CLAUDE.md: ${SITE_NAME}

Consumer of typikon (\`forkwright/typikon\`). The site's structural
contract — templates, schemas, gates — comes from typikon. This repo
holds the site-specific *content* and *brand parameters* only.

## Standards

Authoring rules live in typikon's \`docs/AGENTIC.md\`. Read those before
editing content here.

Frontmatter must validate against the appropriate schema in
typikon \`schemas/\` (page / section / journal-entry / product).
Run \`bin/typikon-validate .\` from the typikon checkout to verify.

## Locked decisions

- **Theme**: \`forkwright/typikon\` via git submodule under \`themes/typikon/\`.
- **Forge-primary**: \`origin\` is the forkwright forge; \`github\` is mirror.
- **Strict CSP**: enforced via \`_headers\`. No inline scripts/styles anywhere.
- **Self-hosted fonts**: served from \`/fonts/\` at first-party origin.

## Refreshing the theme

\`\`\`
themes/typikon/bin/typikon-refresh
git diff --cached  # review
git commit -m "chore(theme): bump typikon to <sha> + regen templates"
\`\`\`

\`typikon-refresh\` bumps the submodule to the latest \`origin/main\`,
re-renders every substituted template (including \`.kanon-ci.toml\`
from \`ci/kanon-ci.toml.tmpl\` and \`.github/workflows/deploy.yml\`
from \`ci/github-workflow.yml.tmpl\`), and leaves the diff staged for
review. Idempotent: re-running with no upstream changes is a no-op.
See \`themes/typikon/bin/typikon-refresh --help\` for env knobs.
EOF
)
"

# Stage only what THIS invocation created (forkwright/typikon#54).
#
# WHY named adds, never `git add -A`: re-running typikon-init over an
# existing destination must not sweep in pre-existing operator-side
# repo state — modified, deleted, staged, or untracked files this
# invocation did not touch. `git add -A` is repository-wide; it does
# not distinguish typikon's own scaffold outputs from unrelated work
# already sitting in the tree. `bin/typikon-refresh` (Step 4) already
# stages this way for its narrower surface (submodule bump + rendered
# templates); this mirrors it for typikon-init's fuller output set.
#
# The submodule gitlink is scoped with its own pathspec'd status check
# rather than folded into OWN_OUTPUTS: `git submodule add` above
# already stages a freshly-added submodule (+ .gitmodules) itself, and
# a `git pull --ff-only` refresh only sometimes moves the checked-out
# commit — `-f` here would be a no-op either way, but the pathspec
# keeps the check (and what gets staged) scoped to exactly that path.
if [[ -n "$(git status --porcelain -- themes/typikon 2>/dev/null)" ]]; then
    git add -f -- themes/typikon
fi
for path in "${OWN_OUTPUTS[@]}"; do
    git add -f -- "$path"
done

# The commit itself is also pathspec-scoped to exactly these outputs
# (`.gitmodules` included: `git submodule add` above stages it, and
# it must ride with the gitlink or the scaffolded submodule is
# broken). `git commit -- <pathspec>` performs a PARTIAL commit — it
# commits only the listed paths' staged content and leaves anything
# else already sitting in the index (e.g. an operator's own pre-staged
# change in a not-yet-committed destination) staged and untouched,
# rather than sweeping it into this commit.
COMMIT_PATHS=(.gitmodules themes/typikon "${OWN_OUTPUTS[@]}")
if [[ -n "$(git diff --cached --name-only -- "${COMMIT_PATHS[@]}" 2>/dev/null)" ]]; then
    if [[ -z "$(git log --oneline 2>/dev/null)" ]]; then
        # WHY: a fresh CI/agentic sandbox has no git identity configured, and
        # this scaffold commit is not an authored change — fall back to a
        # fixed identity for it alone rather than depending on an ambient
        # git config the caller may not have.
        if git config user.email >/dev/null 2>&1 && git config user.name >/dev/null 2>&1; then
            git commit -q -m "chore(${SITE_NAME}): scaffold from typikon" -- "${COMMIT_PATHS[@]}"
        else
            git -c user.name="typikon-init" -c user.email="typikon-init@localhost" \
                commit -q -m "chore(${SITE_NAME}): scaffold from typikon" -- "${COMMIT_PATHS[@]}"
        fi
        echo "ok     initial commit created" >&2
    else
        echo "ok     scaffold refreshed (commit pending if you want to capture refresh)" >&2
    fi
fi

cat <<EOF >&2

Next steps:
    cd $DEST
    bin/typikon-check .                      # local gate (Phase 5 fills out)
    ALLOW_PROTECTED_PUSH=1 git push origin main   # first push only; see <internal-issue-id>
    kanon forge init forkwright/${SITE_NAME}      # create the bare repo on forge

EOF
