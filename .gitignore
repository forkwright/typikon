# Zola build output (consumers, not theme itself)
public/
public-local/
.zola-cache/

# Editor / OS
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Python bytecode (ci/ and bin/ ship .py; running them leaves __pycache__)
__pycache__/
*.py[cod]

# Test artifacts
test-results/
playwright-report/
.playwright/
node_modules/
.lychee_cache/

# Local-only
*.local
.env
.env.local

# Font sources (subsetting workspace; commit only subsetted WOFF2)
fonts-src/
*.ttf
*.otf
*.woff

# Allow only the subsetted WOFF2 we ship
!static/fonts/*.woff2
target/
*.bak

# lychee link-check cache (build state, not source)
.lycheecache
