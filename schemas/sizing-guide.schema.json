{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/forkwright/typikon/schemas/sizing-guide.schema.json",
  "title": "typikon sizing guide",
  "description": "Frontmatter contract for a sizing-guide page (template = 'sizing-guide.html'). Renders a measurement table + measurement instructions; supports a decision-tree block.",
  "type": "object",
  "required": ["title", "extra"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 200 },
    "date": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "path": { "type": "string", "pattern": "^/[a-z0-9/_-]*/?$" },
    "template": { "type": "string", "const": "sizing-guide.html" },
    "weight": { "type": "integer", "minimum": 0 },
    "draft": { "type": "boolean" },
    "extra": {
      "type": "object",
      "required": ["audience", "measurement_source", "product_type", "size_table"],
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120,
          "description": "Intended reader context for the sizing guide."
        },
        "product_type": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "description": "What this guide sizes (e.g. 'belt', 'wallet', 'apron'). Renders in heading + breadcrumb."
        },
        "measurement_unit": {
          "type": "string",
          "enum": ["inches", "centimeters", "both"],
          "default": "inches",
          "description": "Display unit for size_table values. 'both' renders inches and a parenthesized cm conversion."
        },
        "measurement_source": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "description": "Source for numeric sizing claims, e.g. pattern block, sample measurement run, or fixture note."
        },
        "size_table": {
          "type": "array",
          "minItems": 1,
          "description": "One row per size. Columns are flexible per product; common shape: { size, waist, length }.",
          "items": {
            "type": "object",
            "required": ["size"],
            "additionalProperties": false,
            "properties": {
              "size": {
                "type": "string",
                "description": "Size label (e.g. '32', 'Medium', '34-36')."
              },
              "waist": { "type": "string", "description": "Waist measurement (numeric or range) in measurement_unit." },
              "length": { "type": "string", "description": "Length measurement in measurement_unit." },
              "width": { "type": "string", "description": "Width measurement in measurement_unit." },
              "note": { "type": "string", "maxLength": 200, "description": "Per-row note (e.g. 'Sized to last hole; first hole is +2 inches')." }
            }
          }
        },
        "diagram": {
          "type": "string",
          "pattern": "^[a-z0-9/_-]+\\.svg$",
          "description": "Path under static/ to an SVG measurement diagram. Embedded inline so CSS can target its parts."
        },
        "decision_tree": {
          "type": "array",
          "description": "Optional 'how to choose' steps. Each step is a single rule rendered as an ordered-list item.",
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300
          }
        },
        "seo_title": { "type": "string", "maxLength": 80 },
        "body_class": { "type": "string", "pattern": "^[a-z][a-z0-9 -]*$" },
        "og_image": { "type": "string", "pattern": "^[a-z0-9/_-]+\\.(svg|png|jpg|jpeg|webp)$" },
        "skip_sitemap": { "type": "boolean" },
        "author": { "type": "string" }
      }
    }
  }
}
