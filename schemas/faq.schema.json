{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/forkwright/typikon/schemas/faq.schema.json",
  "title": "typikon FAQ page",
  "description": "Frontmatter contract for an FAQ page (template = 'faq.html'). Questions live in extra.questions and emit Schema.org FAQPage JSON-LD automatically.",
  "type": "object",
  "required": ["title", "extra"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 200 },
    "date": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "path": { "type": "string", "pattern": "^/[a-z0-9/_-]*/?$" },
    "template": { "type": "string", "const": "faq.html" },
    "weight": { "type": "integer", "minimum": 0 },
    "draft": { "type": "boolean" },
    "extra": {
      "type": "object",
      "required": ["questions"],
      "additionalProperties": false,
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "description": "Each question + answer pair. Anchors are auto-generated from the question text (slugified) when omitted.",
          "items": {
            "type": "object",
            "required": ["q", "a"],
            "additionalProperties": false,
            "properties": {
              "q": {
                "type": "string",
                "minLength": 5,
                "maxLength": 200,
                "description": "Question text. Becomes <dt> and Question.name in JSON-LD."
              },
              "a": {
                "type": "string",
                "minLength": 5,
                "maxLength": 2000,
                "description": "Answer text. Markdown not parsed (template emits as plain text wrapped in <p>); use \\n\\n for paragraph breaks if needed."
              },
              "anchor": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$",
                "description": "URL fragment for direct linking (e.g. #shipping). Optional — slugified from q if omitted."
              }
            }
          }
        },
        "seo_title": { "type": "string", "maxLength": 80 },
        "body_class": { "type": "string", "pattern": "^[a-z][a-z0-9 -]*$" },
        "og_image": { "type": "string", "pattern": "^[a-z0-9/_-]+\\.(svg|png|jpg|jpeg|webp)$" },
        "skip_sitemap": { "type": "boolean" },
        "author": { "type": "string" }
      }
    }
  }
}
